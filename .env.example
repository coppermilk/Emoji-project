# Get a token by messaging @BotFather on Telegram and running /newbot.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: only these numeric chat IDs may use the bot (comma separated).
# Leave unset to let anyone who finds the bot use it.
# Send /whoami to the bot to learn your own chat ID.
TELEGRAM_ALLOWED_CHATS=

# Optional: default translation style -> summary | inline | full
EMOJIMAIL_STYLE=summary

# Optional: where per-chat preferences are stored.
EMOJIMAIL_PREFS=emojimail_prefs.json
